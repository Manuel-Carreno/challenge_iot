# Copiar a /etc/gateway-hidrico.env y llenar con los valores reales.
# Permisos: sudo chown <usuario>:<usuario> /etc/gateway-hidrico.env
#           sudo chmod 600 /etc/gateway-hidrico.env
# Este archivo de ejemplo SI va en Git; el real NUNCA.

# --- Broker local (Mosquitto) ---
MQTT_USUARIO=gateway
MQTT_CLAVE=<clave-del-usuario-gateway>

# --- Base de datos y origen ---
DB_PATH=/home/<usuario>/gateway-hidrico/lecturas.db
# 'prueba' durante las pruebas; 'mqtt' para datos reales del prototipo
GATEWAY_ORIGEN=prueba

# --- Ubidots (verificar en la documentacion oficial) ---
UBIDOTS_TOKEN=<token-de-ubidots>
UBIDOTS_HOST=industrial.api.ubidots.com
UBIDOTS_TLS=1
UBIDOTS_PUERTO=8883
# UBIDOTS_CA=/home/<usuario>/gateway-hidrico/ubidots.pem   (solo si TLS falla por certificado)
UBIDOTS_DISPOSITIVO=nodo01
UBIDOTS_DISPOSITIVO_CTRL=nodo01-ctrl
# 300 = cada 5 min (plan STEM). Para pruebas cortas: 60
UBIDOTS_INTERVALO_S=300

# --- Modulo de IA (lo llena Camilo) ---
EVENTOS_MD=/home/<usuario>/gateway-hidrico/eventos.md
GEMINI_API_KEY=<clave-de-gemini>
GEMINI_MODEL=<modelo-vigente>
